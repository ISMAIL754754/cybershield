# Versions fixées
HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8
SPARK_IMAGE=apache/spark:3.5.1-scala2.12-java17-python3-ubuntu
KAFKA_IMAGE=apache/kafka:3.7.0
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1

# Kafka
KAFKA_TOPIC=network-flows
KAFKA_PARTITIONS=3

# Ressources des workers Spark
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Producteur
DATASET_DIR=/data
PRODUCER_RATE=200
